rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'fountainheadro@gmail.com' ||
        request.auth.token.email == 'adrianmariusmp@gmail.com' ||
        request.auth.token.email == 'adrian@cautlocuinta.ro'
      );
    }

    // --- Collection Routes ---

    match /leads/{leadId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /personal/{personalId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }

    match /documents/{documentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /tours/{tourId} {
      allow read, write: if isSignedIn();
    }

    match /activities/{activityId} {
      allow read, write: if isSignedIn();
    }

    match /viewings/{viewingId} {
      allow read, write: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    match /fcm_tokens/{tokenId} {
      allow read, write: if isSignedIn();
    }
  }
}
